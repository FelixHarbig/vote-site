# =============================================================================
# Teacher Voting Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in appropriate values.
# DO NOT commit the .env file - it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# For Docker Compose deployment (all services in Docker):
#   DATABASE_URL=postgresql://voteuser:VotePass123@postgres:5432/votedb
#
# For local development (PostgreSQL running on host machine):
#   DATABASE_URL=postgresql://voteuser:VotePass123@localhost:5432/votedb
#
# For Docker backend with host database (Windows/macOS):
#   DATABASE_URL=postgresql://voteuser:VotePass123@host.docker.internal:5432/votedb
#   (Linux requires --add-host=host.docker.internal:host-gateway, already in compose)
#
DATABASE_URL=postgresql://voteuser:VotePass123@postgres:5432/votedb

# PostgreSQL credentials (used by postgres container via env_file)
POSTGRES_USER=voteuser
POSTGRES_PASSWORD=VotePass123
POSTGRES_DB=votedb
POSTGRES_HOST=postgres

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection URL.
# Format: redis://[:<password>@]<host>:<port>
#
# For Docker Compose:
#   REDIS_URL=redis://:your_redis_password@redis:6379
#
# For local development:
#   REDIS_URL=redis://:your_redis_password@localhost:6379
#
# For Docker backend with host Redis:
#   REDIS_URL=redis://:your_redis_password@host.docker.internal:6379
#
REDIS_URL=redis://:2@redis:6379

# Redis password (used by redis container via env_file)
REDIS_PASSWORD=2
REDIS_HOST=redis

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# In production, set to your actual frontend URL.
# Example: FRONTEND_URL=https://voting.yourdomain.com
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin Authentication (Local Admin System)
# -----------------------------------------------------------------------------
# Secret key for admin challenge-response (keep this strong and unique)
ADMIN_SECRET=your_secret_admin_key_here

# JWT secret for admin sessions (must be secure random string, min 32 chars)
JWT_SECRET_KEY=change_this_to_a_secure_random_string_make_it_long_and_random

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT token expiration in hours
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12

# -----------------------------------------------------------------------------
# Supabase Integration (Optional but Recommended for User Auth)
# -----------------------------------------------------------------------------
# Supabase project URL (your project endpoint)
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key - starts with sb_publishable_
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase secret (service role) key - starts with sb_secret_
# Note: Legacy JWT-format service keys (starting with eyJ...) are also supported
# These can be found in older Supabase projects under Settings -> API -> 
# Project API keys (Legacy) -> SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_...  # or eyJhbGciOiJIUzI1NiIs...

# (Legacy aliases supported for backward compatibility)
# SUPABASE_ANON_KEY - alternative to PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY - alternative to SECRET_KEY

# Supabase database URL (if needed for direct DB access)
# Format: postgresql://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# GDPR Controller Information (Required for imprint & privacy policy)
# -----------------------------------------------------------------------------
# Name of the data controller (person or organization)
CONTROLLER_NAME=Your (Company) Name

# Controller address (for legal imprint)
CONTROLLER_ADRESS=Street 123, 12345 City, Country

# Controller contact email (for privacy requests)
CONTROLLER_MAIL=your@email.com

# (Optional) Controller phone
# CONTROLLER_PHONE=+49 123 456789

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------
# Maximum failed attempts before IP ban (default: 10)
MAX_FAILED_ATTEMPTS=10

# -----------------------------------------------------------------------------
# Application Mode
# -----------------------------------------------------------------------------
# Set to TRUE to enable development mode:
#  - FastAPI /docs and /redoc endpoints enabled
#  - More verbose logging
#  - CORS relaxed to localhost:3000,5000,8000,8001
# Set to FALSE for production (docs disabled)
DEV=TRUE

# =============================================================================
# End of configuration template
# =============================================================================
# Notes:
# 1. After editing this file, save as .env in the project root.
# 2. Run `docker compose -f database_reddis_docker/docker-compose.yml up -d`
#    then `docker compose -f backend_docker/docker-compose.yml up -d`
# 3. Apply migrations: `docker compose -f backend_docker/docker-compose.yml exec backend alembic upgrade head`
# 4. Create admin: `python -m app.cli.create_admin --username admin --password <password>`
# =============================================================================
